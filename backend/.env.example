# ------------------------------------------------------------
# FreshLink backend settings - EXAMPLE FILE (safe to commit)
#
# Copy this file to "backend/.env" and change the values there.
# The real .env file is ignored by Git and must NEVER be committed.
# ------------------------------------------------------------

# development | test | production
APP_ENV=development

# Comma-separated list of website origins allowed to call the API (CORS).
# 5173 is the default port of the Vite dev server for the React website.
CORS_ORIGINS=http://localhost:5173

# Show Swagger UI at /docs (turn off in production)
ENABLE_DOCS=true

# Secret that signs login tokens. Generate your own (never share or commit it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_with_the_command_above

# How long a login (access) token is valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15
# How long a login session lasts without any use, in days
REFRESH_TOKEN_EXPIRE_DAYS=14

# Website refresh cookie is HTTPS-only. Browsers accept it on http://localhost,
# so keep true; set false ONLY if you test from another computer over plain http.
REFRESH_COOKIE_SECURE=true

# Brute-force protection: failed logins allowed in the window, per account and per IP.
# The IP limit is higher because many mobile users in Pakistan share one IP address.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SECONDS=60

# The database password is NOT here: it is in FreshLink/.env (shared with Docker).

# Uploaded documents: private folder (git-ignored) and size limit
# STORAGE_DIR=storage
MAX_UPLOAD_MB=5
