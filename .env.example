# ------------------------------------------------------------
# Settings for docker-compose.yml - EXAMPLE FILE (safe to commit)
#
# Copy this file to ".env" in the same folder and choose your own password.
# The real .env is ignored by Git and must NEVER be committed.
# ------------------------------------------------------------

POSTGRES_USER=freshlink
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_password
POSTGRES_DB=freshlink
POSTGRES_PORT=5432
# Used by the backend. Keep 127.0.0.1 (not "localhost": slow on Windows).
POSTGRES_HOST=127.0.0.1
